<%- include('partials/header') %>
<%- include('partials/main_nav') %>

<main class="container page-content">
  <div class="page-layout">
    <!-- Left Column -->
    <div class="left-column">
      <div class="sidebar-card">
        <h3>Profile</h3>
        <figure class="profile-figure">
          <img src="/images/pic.jpg" class="img-fluid" alt="Profile photo of student">
          <figcaption>Student Profile Photo</figcaption>
        </figure>
      </div>
    </div>

    <!-- Right Column -->
    <div class="right-column">
      <div class="main-card">
        <h2>Biography</h2>
        <p>I am a Networking and IT Security student with an interest in infrastructure, secure system configuration, and front-end development.</p>

        <h3>Introductory Video</h3>
        <p>Watch my short introduction video below:</p>
        <video class="intro-video" controls poster="/images/poster.jpg" preload="metadata">
          <source src="/videos/video.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>